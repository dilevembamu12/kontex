{
  "name": "@kontex/sdk",
  "version": "0.1.0-alpha",
  "description": "KontEx SDK TypeScript — Vibe Coding sans hallucination basé sur la TTC",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./anchor": {
      "types": "./dist/anchor.d.ts",
      "import": "./dist/anchor.js"
    },
    "./weaver": {
      "types": "./dist/weaver.d.ts",
      "import": "./dist/weaver.js"
    },
    "./detector": {
      "types": "./dist/detector.d.ts",
      "import": "./dist/detector.js"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.10.0",
    "vitest": "^2.1.0"
  }
}
