# ============================================================
# KontEx — Variables d'Environnement
# ============================================================
# Copiez ce fichier en `.env` et adaptez les valeurs à votre environnement.
# Ne jamais commiter le vrai `.env` (présent dans .gitignore).
#
# @anchor: PROJECT_CONTEXT.md §3.1 — PostgreSQL+pgvector, Redis
# @anchor: .cursorrules sécurité B2B2B — aucun secret dans le code
# ============================================================

# --- Environnement d'exécution ---
# Valeurs possibles : development | production | test
NODE_ENV=development

# --- API Gateway ---
# Port d'écoute de l'API KontEx
PORT=3000

# Origine autorisée pour CORS (frontend Next.js en développement)
CORS_ORIGIN=http://localhost:5173

# Niveau de log applicatif
# Valeurs possibles : debug | info | warn | error
LOG_LEVEL=info

# --- Base de données PostgreSQL + pgvector ---
# Format : postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://kontex:kontex@localhost:5432/kontex

# Variables utilisées par docker-compose pour initialiser PostgreSQL
POSTGRES_USER=kontex
POSTGRES_PASSWORD=kontex
POSTGRES_DB=kontex
POSTGRES_PORT=5432

# --- Cache Redis ---
# Format : redis://<host>:<port>
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# --- Moteur TTC (Phase 1+) ---
# Endpoint gRPC du moteur TTC Rust
# GRAPHITI_GRPC_URL=localhost:50051

# --- Sécurité (Phase 3+) ---
# JWT_SECRET=votre-secret-jwt-a-changer-en-production
# API_KEY=votre-cle-api
